{
  "name": "@fantastic.dev/convex-env-sync",
  "version": "0.1.0",
  "description": "Convex environment synchronization for Alchemy projects and pluggable secret sources.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasticDevHQ/convex-env-sync.git"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test:pr-standard": "node --test scripts/pr-standard.test.mjs scripts/enforce-pr-standard.test.mjs",
    "test:worktree": "node --test scripts/worktree/*.test.mts",
    "worktree:setup": "node scripts/worktree/cli.mts setup",
    "worktree:start": "node scripts/worktree/cli.mts start",
    "worktree:stop": "node scripts/worktree/cli.mts stop",
    "worktree:teardown": "node scripts/worktree/cli.mts teardown",
    "worktree:cleanup": "node scripts/worktree/cli.mts cleanup",
    "worktree:prune": "node scripts/worktree/cli.mts prune"
  },
  "dependencies": {
    "@distilled.cloud/convex": "1.0.0-rc.20",
    "@distilled.cloud/doppler": "1.0.0-rc.20",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.87"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.87"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  },
  "bin": {
    "convex-env-sync": "./src/cli/main.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./sources/doppler": "./src/sources/doppler.js",
    "./sources/infisical": "./src/sources/infisical.js",
    "./convex/deployment": "./src/convex/deployment.js",
    "./convex/defaults": "./src/convex/defaults.js",
    "./cli": "./src/cli/commands.js",
    "./alchemy": "./src/alchemy/index.js"
  },
  "files": [
    "src/alchemy/index.js",
    "src/cli/commands.js",
    "src/cli/main.js",
    "src/cli/ownership.js",
    "src/convex/client.js",
    "src/convex/defaults.js",
    "src/convex/deployment.js",
    "src/core/manifest.js",
    "src/core/plan.js",
    "src/core/reconcile.js",
    "src/core/stages.js",
    "src/core/verify.js",
    "src/index.js",
    "src/sources/doppler.js",
    "src/sources/infisical.js",
    "docs/architecture.md",
    "docs/configuration.md",
    "docs/alchemy.md",
    "docs/cli.md",
    "docs/package.md",
    "assets/fantastic-dev-logo.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/FantasticDevHQ/convex-env-sync#readme",
  "bugs": {
    "url": "https://github.com/FantasticDevHQ/convex-env-sync/issues"
  },
  "keywords": [
    "convex",
    "environment",
    "doppler",
    "alchemy",
    "secrets"
  ]
}
